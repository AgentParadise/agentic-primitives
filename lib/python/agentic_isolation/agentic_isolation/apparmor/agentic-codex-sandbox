# AppArmor profile for workspaces that can run Codex (agentic-isolation).
#
# Docker's docker-default profile (moby/profiles/apparmor template vendored in
# docker-v29.8.0) with ONE change: its blanket `deny mount,` is replaced by the
# exact mount and pivot_root operations bubblewrap performs inside its own user
# and mount namespace, plus explicit denials. Everything else is docker-default
# verbatim. No `userns,`
# rule is needed: this profile uses ABI 3.0 like docker-default, and user
# namespace creation is gated by the paired seccomp profile, not AppArmor.
#
# Load on the Docker host before starting Codex-capable workspaces:
#   sudo apparmor_parser -r agentic-codex-sandbox
# Provenance and verification: README.md next to this file.

abi <abi/3.0>,
#include <tunables/global>

profile agentic-codex-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer="unconfined",
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="agentic-codex-sandbox",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # --- agentic-isolation: bubblewrap sandbox construction (replaces `deny mount,`)
  # Exactly the mount operations codex-cli 0.156.1's bubblewrap performs for
  # sandbox_mode read-only and workspace-write, recorded in complain mode on
  # an AppArmor host (see README.md). Anything else stays denied. These only
  # take effect inside a user namespace the container created itself; the
  # container holds no capabilities in the initial namespace.
  #
  # 1. Stop propagation, build the staging root on a tmpfs over /tmp, enter it.
  mount options=(rw, silent, rslave) -> /,
  mount fstype=tmpfs options=(rw, nosuid, nodev) tmpfs -> /tmp/,
  mount options=(rw, rbind) /tmp/newroot/ -> /tmp/newroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  # 2. Sandbox tree: the old root (or its /usr and /etc) bound under /newroot.
  mount fstype=tmpfs options=(rw, nosuid, nodev) tmpfs -> /newroot/,
  mount options=(rw, rbind) /oldroot/ -> /newroot/,
  mount options=(rw, rbind) /oldroot/usr/ -> /newroot/usr/,
  mount options=(rw, rbind) /oldroot/usr/bin/ -> /newroot/bin/,
  mount options=(rw, rbind) /oldroot/usr/sbin/ -> /newroot/sbin/,
  mount options=(rw, rbind) /oldroot/usr/lib/ -> /newroot/lib/,
  mount options=(rw, rbind) /oldroot/usr/lib64/ -> /newroot/lib64/,
  mount options=(rw, rbind) /oldroot/etc/ -> /newroot/etc/,
  # 3. Minimal /dev, /proc and /dev/pts.
  mount fstype=tmpfs options=(rw, nosuid, nodev) tmpfs -> /newroot/dev/,
  mount options=(rw, rbind) /oldroot/dev/null -> /newroot/dev/null,
  mount options=(rw, rbind) /oldroot/dev/zero -> /newroot/dev/zero,
  mount options=(rw, rbind) /oldroot/dev/full -> /newroot/dev/full,
  mount options=(rw, rbind) /oldroot/dev/random -> /newroot/dev/random,
  mount options=(rw, rbind) /oldroot/dev/urandom -> /newroot/dev/urandom,
  mount options=(rw, rbind) /oldroot/dev/tty -> /newroot/dev/tty,
  mount fstype=devpts options=(rw, nosuid, noexec) devpts -> /newroot/dev/pts/,
  mount fstype=proc options=(rw, nosuid, nodev, noexec) proc -> /newroot/proc/,
  # 4. Writable roots (workspace-write): /tmp and the working directory, which
  #    must be under /workspace. Codex masks .git/.codex/.agents in each root
  #    and its daemon directory with read-only tmpfs.
  mount options=(rw, rbind) /oldroot/tmp/ -> /newroot/tmp/,
  mount options=(rw, rbind) /oldroot/tmp/codex-bwrap-synthetic-mount-targets-*/ -> /newroot/tmp/codex-bwrap-synthetic-mount-targets-*/,
  mount options=(rw, rbind) /oldroot/workspace/{,**/} -> /newroot/workspace/{,**/},
  mount fstype=tmpfs options=(rw, nosuid, nodev) tmpfs -> /newroot/tmp/codex-daemon-*/,
  mount fstype=tmpfs options=(rw, nosuid, nodev) tmpfs -> /newroot/{tmp,workspace,workspace/**}/.{git,codex,agents}/,
  # 5. Remounts. Read-only anywhere in the sandbox tree (only ever narrows);
  #    read-write only on the writable workspace roots.
  mount options=(ro, nosuid, nodev, remount, bind, silent, relatime) -> /newroot/{,**},
  mount options=(ro, nosuid, nodev, noexec, remount, bind, silent, relatime) -> /newroot/{,**},
  mount options=(ro, nosuid, nodev, remount, bind, silent) -> /newroot/{,**},
  mount options=(rw, nosuid, nodev, remount, bind, silent, relatime) -> /newroot/workspace/{,**/},
  # 6. Drop the old root and switch into the sandbox.
  mount options=(rw, silent, rprivate) -> /oldroot/,
  pivot_root oldroot=/newroot/ /newroot/,
  # Explicit denials for sensitive sources and filesystems (deny wins).
  deny mount fstype=sysfs,
  deny mount fstype=cgroup,
  deny mount fstype=cgroup2,
  deny mount fstype=securityfs,
  deny mount fstype=debugfs,
  deny mount fstype=tracefs,
  deny mount fstype=bpf,
  deny mount /{,oldroot/}{proc,sys}/** -> /**,
  deny mount /{,oldroot/}{run,var/run}/** -> /**,
  deny mount /**/docker.sock -> /**,
  deny mount options=(rw, nosuid, nodev, remount, bind, silent, relatime) -> /newroot/{etc,usr,bin,sbin,lib,lib64,proc,sys,dev}/{,**},
  # --- end agentic-isolation

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="agentic-codex-sandbox",
}
