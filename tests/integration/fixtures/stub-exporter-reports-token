#!/usr/bin/env bash
# Test stub standing in for SeshMagicSessionExporter, for the credential
# withholding test only.
#
# Same summary line as the plain stub-exporter, plus one fact the plain stub
# cannot report: whether the store write credential was actually in this
# process's environment. That is what makes "withheld from the agent" and
# "still available to finalize" two separate, checkable claims rather than one
# claim that could be satisfied by simply breaking the upload.
#
# It reports PRESENCE, never the value.
#
# The report goes to a FILE under the spool, not to a stream. finalize.sh
# captures the exporter's stdout and stderr and deliberately never replays
# them, because a real exporter is an operator-supplied binary whose output
# is not trusted in a durable log, so anything printed here reaches nobody.
# The test reads the file from the host side of the spool mount.
set -eu

if [ "${1:-}" = "--version" ]; then
    echo "SeshMagicSessionExporter 0.0.0-stub"
    exit 0
fi

__report="/spool/.stub-exporter-token-report"
if [ -n "${SESSIONS_WRITE_TOKEN:-}" ]; then
    echo "STUB_EXPORTER_TOKEN=present" > "${__report}"
else
    echo "STUB_EXPORTER_TOKEN=absent" > "${__report}"
fi

echo "run: discovered=1 skipped_unchanged=0 uploaded=1 accepted=1 duplicate=0 rejected=0 skipped_oversize=0 failed=0"
exit 0
